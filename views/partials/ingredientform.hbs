<div>
  <label for="name">Name of the ingredient:</label>
  <input type="text" name="name" id="name" value="{{ingredient.name}}" required />
</div>
<div>
  <label for="onSeason">Is it on season? </label>
  <input type="hidden" name="onSeason" value="false" />
  <input 
    type="checkbox" 
    id="onSeason" 
    name="onSeason" 
    value="onSeason" 
    {{#unless (eq ingredient.onSeason false)}} checked {{/unless}} 
  />
</div>