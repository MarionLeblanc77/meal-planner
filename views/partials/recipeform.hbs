<div>
  <label for="name">Name of the recipe:</label>
  <input type="text" name="name" id="name" value="{{recipe.name}}" required />
</div>
<div>
  <label for="instructions">Instructions:</label>
  <textarea id="instructions" name="instructions" rows="5" cols="33">
  </textarea>
</div>
<div>
  <label for="basePortions">Base Portions:</label>
  <input type="number" name="basePortions" id="basePortions" value="{{recipe.basePortions}}" />
</div>