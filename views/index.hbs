<form action="/recipes" method="post">
  <div>
    <label for="name">Name of the recipe:</label>
    <input type="text" name="name" id="name" required />
  </div>
  <div>
    <label for="basePortion">Base Portions:</label>
    <input type="number" name="basePortion" id="basePortion" required />
  </div>
  <button>Add this recipe</button>
</form>
